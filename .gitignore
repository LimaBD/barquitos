# ============================================================================
# Barquitos — .gitignore
# ============================================================================

# ----- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl

# ----- Virtual environments -------------------------------------------------
.venv/
venv/
env/

# ----- IDE / Editor ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Environment / Secrets ------------------------------------------------
.env

# ----- Data (large / generated) ---------------------------------------------
# Raw AIS JSONL files (collected data — too large for git)
ais_collector/data_samples/
*.jsonl

# SQLite databases
*.db
*.db-wal
*.db-shm

# Processed / backup data
ais_processed/

# ----- OS -------------------------------------------------------------------
.DS_Store
Thumbs.db
