# ============================================================================
# Barquitos — .gitignore
# ============================================================================

# ----- Rust ------------------------------------------------------------------
# Workspace build outputs (pipeline/ is the Cargo workspace root)
pipeline/target/
pipeline/crates/*/target/
# Leftover root-level target/ from before the pipeline/ reorganisation
/target/
**/*.rs.bk

# ----- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl

# ----- Virtual environments -------------------------------------------------
.venv/
venv/
env/

# ----- Node / Frontend -------------------------------------------------------
node_modules/
dashboard/static/assets/

# ----- IDE / Editor ----------------------------------------------------------
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ----- Environment / Secrets -------------------------------------------------
.env
.env.*
secrets.toml
# config.toml holds non-secret defaults and IS committed;
# use config.local.toml for machine-specific overrides (not committed)
config.local.toml
*.toml.old

# ----- Data (large / generated) ----------------------------------------------
*.jsonl
*.parquet
*.arrow
*.db
*.db-wal
*.db-shm
trading_lake/
ais_processed/

# ----- Logs & PID files ------------------------------------------------------
*.log
*.pid

dashboard/frontend/dist/

# ----- OS -------------------------------------------------------------------
.DS_Store
Thumbs.db
