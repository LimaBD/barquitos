# ============================================================================
# Barquitos — .gitignore
# ============================================================================

# ----- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl

# ----- Virtual environments -------------------------------------------------
.venv/
venv/
env/

# ----- IDE / Editor ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Environment / Secrets ------------------------------------------------
.env

# ----- Rust ------------------------------------------------------------------
ais_ingestor_rs/target/
ais_collector_rs/target/

# ----- Data (large / generated) ---------------------------------------------
# Raw AIS JSONL files (collected data — too large for git)
ais_collector_rs/data_samples/
ais_ingestor_rs/test_data/
*.jsonl

# Database files
*.db
*.db-wal
*.db-shm

# Parquet Data Lake (lives on /mnt/wdblack/trading_lake/)
*.parquet
trading_lake/

# Processed / backup data
ais_processed/

# PID / log files from ingestor daemon
*.pid
ais_ingestor_rs/*.log

# ----- Node / Frontend ------------------------------------------------------
node_modules/
dashboard/frontend/dist/

# ----- OS -------------------------------------------------------------------
.DS_Store
Thumbs.db
